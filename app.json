{
  "expo": {
    "name": "Vorster Unlimited Helper",
    "slug": "vorster-unlimited-helper",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "za.co.vorsterunlimited.helper"
    },
    "ios": {
      "bundleIdentifier": "za.co.vorsterunlimited.helper"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Vorster Unlimited Helper to scan job card QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ]
  }
}
