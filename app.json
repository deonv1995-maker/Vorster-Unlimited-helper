{
  "expo": {
    "name": "Vorster Unlimited Helper",
    "slug": "vorster-unlimited-helper",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "za.co.vorsterunlimited.helper"
    },
    "ios": {
      "bundleIdentifier": "za.co.vorsterunlimited.helper"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Vorster Unlimited Helper to scan paper job cards and QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-mlkit-ocr",
        {
          "iosEngine": "auto"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}
